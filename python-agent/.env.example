# Caminho relativo a este arquivo. Sem .env, ../data é encontrado automaticamente.
DATA_DIR=../data

# Opção atual: modelo remoto na Groq. Chave somente no .env local.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=90
GROQ_API_KEY=

# Alternativa API: LLM_PROVIDER=openai + LLM_MODEL + OPENAI_API_KEY
# Outro endpoint: LLM_PROVIDER=openai_compatible + LLM_BASE_URL + LLM_API_KEY
# Ollama opcional: LLM_PROVIDER=ollama + LLM_MODEL=qwen3:1.7b + LLM_BASE_URL=http://127.0.0.1:11434
